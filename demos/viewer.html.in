<!doctype html>
<html lang="zh-CN">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="color-scheme" content="light">
<title>无人叉车托盘定位 · 仿真回放</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f3f3ef;color:#18272b;font:16px/1.68 "Microsoft YaHei",system-ui,sans-serif}main{max-width:1080px;margin:auto;padding:42px 30px 48px}
h1,h2,h3,p{margin:0}h1{font-size:clamp(28px,5vw,53px);line-height:1.24;letter-spacing:-.045em}h2{font-size:clamp(24px,4vw,36px);line-height:1.3;letter-spacing:-.035em;margin-bottom:8px}h3{font-size:15px}p{max-width:795px}
.intro{margin:12px 0 22px;color:#47585a}.tag{color:#336a64;font-size:12px;letter-spacing:.12em;font-weight:bold;margin-bottom:8px}
.view{background:#12272c;color:#e3f0e9;border-radius:16px;overflow:hidden}.viewhead,.controls{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:14px 20px}.viewhead{border-bottom:1px solid #355053}.viewhead span,.controls span{font-size:13px;color:#abc3bf}
canvas{display:block;width:100%;height:clamp(260px,40vw,395px);touch-action:none;cursor:grab;outline-offset:-5px}canvas:active{cursor:grabbing}.controls{border-top:1px solid #355053;flex-wrap:wrap}.buttons{display:flex;gap:6px}button{font:inherit;font-size:13px;color:#ddefe5;border:1px solid #5c787a;border-radius:5px;background:transparent;padding:4px 9px;cursor:pointer}button:hover,button:focus-visible{background:#305559}button:focus-visible,a:focus-visible{outline:3px solid #e5ab58}
nav{display:flex;gap:15px;flex-wrap:wrap;border-bottom:1px solid #cad3cb;padding:19px 0}a{color:#24655d;text-underline-offset:4px}section{padding-top:34px;margin-top:8px}.lead{color:#445a59;margin-bottom:14px}
figure{margin:16px 0 0}figure img{display:block;width:100%;max-height:75vh;object-fit:contain;background:#e5eae5;border-radius:8px}figcaption{font-size:13px;color:#485c59;margin:7px 0}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:9px;margin-top:16px}.metric{padding:12px 16px;background:#e1e9e1;border-radius:7px}.metric b{display:block;font-family:Consolas,monospace;font-size:25px;line-height:1.3}.metric span{font-size:13px}
.pair{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.tech{margin-top:10px;color:#425b59;font-size:14px}details{background:#e6ece6;border-radius:6px;margin-top:10px;padding:8px 13px}summary{cursor:pointer}footer{color:#516563;font-size:13px;border-top:1px solid #c9d3cb;margin-top:36px;padding-top:16px}.call{font-weight:bold;color:#275f54}
@media(max-width:600px){main{padding:22px 14px 36px}.metrics,.pair{grid-template-columns:1fr}.metric{display:flex;align-items:baseline;gap:10px}.viewhead{align-items:flex-start}.controls{padding:10px}.viewhead span{font-size:11px}}
</style>
<main>
<header><p class="tag">RGB-D / 机器人视觉仿真</p><h1>无人叉车如何对准托盘</h1><p class="intro">从相机记录的表面恢复叉孔入口，再用实体货叉验证进入方向。拖动下方点云，可以看见单个视角实际观测到的木板表面。</p></header>
<div class="view"><div class="viewhead"><h3>首帧 RGB-D 点云</h3><span>{{POINT_COUNT}} 个显示采样点 · 米制坐标</span></div>
<canvas id="cloud" width="900" height="390" tabindex="0" aria-label="可旋转的托盘观测点云。方向键旋转，Home 恢复初始视角。"></canvas>
<div class="controls"><span>左右拖动或用方向键旋转。青色为估计入口，网格间距 0.1 m。</span><div class="buttons"><button type="button" id="front">正视</button><button type="button" id="side">斜视</button><button type="button" id="top">俯视</button></div></div></div>
<nav aria-label="回放目录"><a href="#depth">RGB-D 与坐标</a><a href="#detect">自动定位与重观测</a><a href="#fork">虚拟货叉</a><a href="#sem">语言选目标</a><a href="#evaluation">实验结果</a></nav>
<section id="depth"><h2>叉孔中心的深度落在哪里？</h2><p class="lead">正前方相机看穿两个开口，原始深度落在后墙。用前面板上的四个实木点拟合平面，再与穿过叉孔中心的两条视线求交，就能恢复前沿位置。</p>
<figure><img loading="lazy" src="../../sample_run/front/overlay.png" alt="彩色标记和轴向深度"><figcaption>黄色十字是用于拟合平面的实木点，绿色圆圈标出两个入口；右图黄色对应远处背景。</figcaption></figure>
<div class="metrics"><div class="metric"><b>{{RAW_Z}} m</b><span>左孔中心的像素深度</span></div><div class="metric"><b>{{ENTRY_Z}} m</b><span>左孔前沿的估计深度</span></div><div class="metric"><b>{{DELTA}} mm</b><span>移动相机后的中点差</span></div></div>
<details><summary>看两种深度在车体侧视图中的位置</summary><figure><img src="../../sample_run/front/side.png" alt="原始深度和前沿位置的车体侧视图"></figure></details></section>
<section id="detect"><h2>让几何证据决定是否对接</h2><p class="lead">自动算法在彩色和深度观测中寻找入口；两孔证据不足时，换到另一个相机位置重新取一帧。下图按实际运行状态展示每一步。</p>{{DETECT}}</section>
<section id="fork"><h2>货叉能否通过两个入口？</h2><p class="lead">对比居中轨迹与带偏航误差的轨迹。碰撞检查使用货叉和托盘实体的连续扫掠几何。</p><figure>{{DOCKING}}</figure></section>
<section id="sem"><h2>一条指令，对应哪个托盘？</h2><p class="lead">在候选托盘上附加可读编号，使目标选择与后续的位姿估计能够分别评测。查看对应记录中的实际运行后端与输出。</p><figure>{{SEMANTIC}}</figure>{{SEM_LINK}}</section>
<section id="mission"><h2>执行一条完整的取货指令</h2>{{MISSION}}</section>
<section id="evaluation"><h2>测试覆盖与失败案例</h2>{{BENCH}}</section>
<footer>本地合成 RGB-D 观测 · 尺寸与坐标均来自场景配置。点云经过区域裁剪与采样，仅呈现首帧实际可见表面。<br><a href="../../README.md">项目说明与复现入口</a></footer>
</main>
<script>
const cloudEl=document.getElementById('cloud'),ctx=cloudEl.getContext('2d');
const binary=atob('{{CLOUD_DATA}}'),bytes=Uint8Array.from(binary,c=>c.charCodeAt(0)),view=new DataView(bytes.buffer),pts=[];
for(let i=0;i<bytes.length;i+=9){pts.push([view.getInt16(i,true)/1000,view.getInt16(i+2,true)/1000,view.getInt16(i+4,true)/1000,'rgb('+bytes[i+6]+','+bytes[i+7]+','+bytes[i+8]+')'])}
const holes={{HOLES_JS}};
let yaw=.38,tilt=.21,tracking=null;
function draw(){
 const w=cloudEl.clientWidth,h=cloudEl.clientHeight,d=Math.min(window.devicePixelRatio||1,2);
 if(cloudEl.width!==Math.round(w*d)||cloudEl.height!==Math.round(h*d)){cloudEl.width=Math.round(w*d);cloudEl.height=Math.round(h*d)}
 ctx.setTransform(d,0,0,d,0,0);ctx.fillStyle='#142a2f';ctx.fillRect(0,0,w,h);
 const scale=Math.min(w/1.6,h/.82),a=Math.cos(yaw),b=Math.sin(yaw),s=Math.sin(tilt),c=Math.cos(tilt);
 function proj(q){const X=q[0]-2.10,Y=q[1],Z=q[2]-.20,F=X*a+Y*b;
 return [w*.50+scale*(X*b-Y*a),h*.53-scale*(Z*c+F*s),F*c-Z*s]}
 function edge(u,v,color){const A=proj(u),B=proj(v);ctx.strokeStyle=color;ctx.beginPath();ctx.moveTo(A[0],A[1]);ctx.lineTo(B[0],B[1]);ctx.stroke()}
 for(let i=-7;i<=7;i++){edge([1.4,i/10,0],[2.8,i/10,0],'#2e4549');edge([2.1+i/10,-.7,0],[2.1+i/10,.7,0],'#2e4549')}
 let sorted=pts.map(p=>[...proj(p),p[3]]).sort((a,b)=>b[2]-a[2]);let radius=Math.max(1.4,scale*.0055);
 for(const p of sorted){ctx.fillStyle=p[3];ctx.fillRect(p[0]-radius/2,p[1]-radius/2,radius,radius)}
 ctx.font='bold 12px system-ui';for(let i=0;i<holes.length;i++){let P=proj(holes[i]);ctx.strokeStyle='#78f6e4';ctx.lineWidth=2;ctx.beginPath();ctx.arc(P[0],P[1],6,0,2*Math.PI);ctx.stroke();ctx.fillStyle='#8ef1e0';ctx.fillText('H'+(i+1),P[0]+9,P[1]-5)}ctx.lineWidth=1;
}
function setPose(a,b){yaw=a;tilt=Math.max(-.5,Math.min(1.45,b));draw()}
document.getElementById('front').onclick=()=>setPose(0,0);
document.getElementById('side').onclick=()=>setPose(.59,.28);
document.getElementById('top').onclick=()=>setPose(.20,1.40);
cloudEl.onpointerdown=e=>{tracking=[e.clientX,e.clientY];cloudEl.setPointerCapture(e.pointerId)};
cloudEl.onpointermove=e=>{if(tracking){setPose(yaw+(e.clientX-tracking[0])*.007,tilt+(e.clientY-tracking[1])*.006);tracking=[e.clientX,e.clientY]}};
cloudEl.onpointerup=cloudEl.onpointercancel=()=>tracking=null;
cloudEl.onkeydown=e=>{const steps={ArrowLeft:[-.12,0],ArrowRight:[.12,0],ArrowUp:[0,.09],ArrowDown:[0,-.09]};if(steps[e.key]){e.preventDefault();const [a,b]=steps[e.key];setPose(yaw+a,tilt+b)}else if(e.key==='Home'){e.preventDefault();setPose(.38,.21)}};
new ResizeObserver(draw).observe(cloudEl);draw();
</script></html>
